<?xml version="1.0" encoding="utf-8"?>
<!-- TK APPROVED (2026-07-28): same white rounded box as every other field,
     with a small chevron on the right so it is obvious the field opens a
     list. Only the drawing changes; the field itself is untouched. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/input_border" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_picker_chevron"
        android:gravity="center_vertical|right"
        android:right="14dp"
        android:width="18dp"
        android:height="18dp" />
</layer-list>
