<?xml version="1.0" encoding="utf-8"?>
<!-- TK-REQUESTED (2026-07-19): plain table-row look (matching the paper
     register — a simple ruled line under each row), not the rounded card
     shell used elsewhere. White background, light bottom border, and a tap
     ripple so the row visibly responds to a tap (opens the Report Card). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#D6E4F0">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#E5E8EC" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
