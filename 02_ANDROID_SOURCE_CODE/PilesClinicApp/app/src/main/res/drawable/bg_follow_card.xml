<?xml version="1.0" encoding="utf-8"?>
<!-- Follow-up card: white rounded card (radius 18) with a 4dp blue left stripe,
     matching the WebView .followCard.finalFollow (border-left:4px #0b66d8). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B66D8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#E4EDEC" />
        </shape>
    </item>
</layer-list>
