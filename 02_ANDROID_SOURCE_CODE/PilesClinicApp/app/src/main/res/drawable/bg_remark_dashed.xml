<?xml version="1.0" encoding="utf-8"?>
<!-- TK-APPROVED (2026-07-25, via photo proof, Option C): light green so
     staff can spot the remark box at a glance without needing a "LAST
     REMARK:" label anymore (label removed from every screen that uses
     this box — see DoctorVisitAdapter.kt/FollowUpAdapter.kt/
     DraftCardAdapter.kt/FollowUpActivity.kt). Was near-white (#FBFDFF)
     with a blue dashed border; shared by every card that shows a remark,
     so this one change applies everywhere consistently. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#EAF9F0" />
    <corners android:radius="12dp" />
    <stroke android:width="1.3dp" android:color="#5DBE84" android:dashWidth="4dp" android:dashGap="3dp" />
</shape>
