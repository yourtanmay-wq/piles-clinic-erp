<?xml version="1.0" encoding="utf-8"?>
<!-- TK APPROVED (2026-07-16): Chamber Attendance row background for
     "Arrived" status — light green fill + green left stripe, same shape
     (18dp corners, 4dp stripe) as bg_follow_card.xml, only the colors
     differ so an arrived patient's card is visually distinct at a glance. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14965A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0F7EB" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#B7E9CC" />
        </shape>
    </item>
</layer-list>
