<?xml version="1.0" encoding="utf-8"?>
<!-- TK APPROVED (2026-07-15): premium metallic-silver look for the new
     "Apply Common ..." buttons (Prescription / Medicine Slip / Blood Test /
     Print Center Walk-in) only: not used anywhere else, so no other
     existing button/design is touched. Diagonal light-to-mid-grey gradient
     plus a soft highlight edge gives a brushed-metal / 3D depth feel. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#C9CED6"
                android:centerColor="#9AA1AC"
                android:endColor="#7C838E"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#E9ECF1" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F4F6F9"
                android:centerColor="#D6DBE2"
                android:endColor="#A7ADB8"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</selector>
