<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar header badge — top (month) strip. Added 2026-07-16 (TK-reported:
     the old ⏰ emoji's built-in glyph artwork showed a fixed, wrong-looking
     date baked into the emoji itself, not the app's real date). Only used by
     the new calendar badge in activity_followup.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/clinic_accent_red" />
    <corners
        android:topLeftRadius="6dp"
        android:topRightRadius="6dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
