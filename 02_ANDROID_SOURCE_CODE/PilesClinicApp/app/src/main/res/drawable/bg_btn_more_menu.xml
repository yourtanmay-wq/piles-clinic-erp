<?xml version="1.0" encoding="utf-8"?>
<!-- More-menu button background (TK-requested, 2026-07-16): plain solid navy
     replaced with the same navy->blue->green dual-color gradient already
     used for headers (bg_login_hero), just with rounded corners for a
     button. Only visual; no id/click logic touched. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/brand_navy"
        android:centerColor="@color/brand_blue"
        android:endColor="@color/brand_green" />
    <corners android:radius="10dp" />
</shape>
