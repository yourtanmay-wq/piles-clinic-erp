<?xml version="1.0" encoding="utf-8"?>
<!-- TK-APPROVED (2026-07-20): a single LEFT divider line for the chamber grid
     cells (Treatment / Fees / Cash / Online). The shape's right/top/bottom
     edges are pushed just outside the view bounds so only the left stroke
     shows; the interior stays transparent, letting the row's status colour
     (green/yellow/red) show through. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="-2dp" android:top="-2dp" android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#D6E0EA" />
        </shape>
    </item>
</layer-list>
