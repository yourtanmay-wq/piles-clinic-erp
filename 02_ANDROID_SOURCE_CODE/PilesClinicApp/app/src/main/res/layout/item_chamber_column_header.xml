<?xml version="1.0" encoding="utf-8"?>
<!-- 🔒🎨 খাতার সারি B473 (05.08.2026, TK-নির্দেশ — "PATIENT | TREATMENT
     PROGRESS | FEES | CASH | ONLINE হেডার ৫টা বক্সের নিচে থাকবে, স্ক্রল
     করলে শুধু বক্স হাইড হবে, হেডার আটকে (pin) থাকবে")।

     এই লেআউটটা আগের activity_chamber_attendance.xml-এর ভিতরের
     "tableHeaderRow" ব্লক থেকে হুবহু কপি করা — একটা অক্ষরও (রং/মাপ/আইডি)
     বদলানো হয়নি, শুধু একটা আলাদা, পুনর্ব্যবহারযোগ্য ফাইলে সরানো হলো, যাতে
     এটা দুই জায়গায় (RecyclerView-এর ভিতরের সাধারণ আইটেম + উপরে পিন-করা
     ডুপ্লিকেট) হুবহু একই দেখায়। -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_chamber_table_header"
    android:paddingVertical="4dp">

    <TextView
        android:layout_width="116dp"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:text="PATIENT"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="TREATMENT PROGRESS"
        android:textSize="8.5sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvHeaderPayment"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="FEES"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvHeaderCash"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="CASH"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvHeaderOnline"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="ONLINE"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:textColor="@color/white" />
</LinearLayout>
