<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF3F8">

    <!-- TK-REPORTED BUG FIX (2026-07-25): this header was locked to a
         fixed 48dp when the headers were made smaller, so any title that
         needs two lines (or a title plus the patient name/ID line under it)
         had its lower line cut off. Height is now "only as much as the text
         needs", with 48dp as the MINIMUM . short titled screens stay exactly
         as small as they are now, and only a long title grows, by about
         8dp. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/bg_login_hero"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/white"
        app:title="Print Preview" />

    <TextView android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:gravity="center" android:textColor="@color/clinic_text_secondary" android:visibility="gone" />

    <androidx.cardview.widget.CardView
        android:id="@+id/pageNavRow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="10dp" app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="@color/clinic_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPrevPage"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="◀ PREV" />
            <TextView android:id="@+id/tvPageIndicator" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:textStyle="bold" android:textColor="@color/clinic_text_primary" android:text="Page 1 of 1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNextPage"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="NEXT ▶" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="10dp" android:clipToPadding="false">
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" app:cardCornerRadius="8dp" app:cardElevation="8dp" app:cardBackgroundColor="@color/white">
            <ImageView android:id="@+id/ivPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:adjustViewBounds="true" android:background="@color/white" android:contentDescription="PDF preview page" />
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- 🔒 B601 (TK-নির্দেশ 09.08.2026): ওয়েবের মতো সমান ৪ বোতাম — WhatsApp / Save /
         Print / Close (২x২ গ্রিড, সব একই মাপ)। এই পর্দা Print Center + বার্তা-বাক্স
         দুটোতেই ব্যবহার হয়, তাই সব প্রিন্ট-প্রিভিউতে একরকম। ⛔ বোতামের কাজ অপরিবর্তিত;
         SHARE PDF এখন সরাসরি WhatsApp টার্গেট করে (না থাকলে সাধারণ Share)। -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="10dp" android:background="@color/clinic_card" android:elevation="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSharePdf"
                android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_height="52dp"
                android:textSize="12sp" android:textStyle="bold" android:text="💬 WhatsApp"
                android:background="@drawable/bg_btn_green" app:backgroundTint="@null" android:textColor="@color/white" app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSavePdf"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="4dp" android:layout_height="52dp" android:textSize="12sp" android:text="💾 Save"
                app:cornerRadius="12dp" app:strokeColor="@color/brand_navy" android:textColor="@color/brand_navy" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPrint"
                android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_height="52dp"
                android:textSize="12sp" android:textStyle="bold" android:text="🖨 Print"
                android:background="@drawable/bg_btn_navy" app:backgroundTint="@null" android:textColor="@color/white" app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnClosePreview"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="4dp" android:layout_height="52dp" android:textSize="12sp" android:text="✕ Close"
                app:cornerRadius="12dp" app:strokeColor="@color/clinic_text_secondary" android:textColor="@color/clinic_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
