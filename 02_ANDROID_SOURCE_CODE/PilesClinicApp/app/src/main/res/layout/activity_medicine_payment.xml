<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_silver_screen">

    <!-- TK-REPORTED BUG FIX (2026-07-25): this header was locked to a
         fixed 48dp when the headers were made smaller, so any title that
         needs two lines (or a title plus the patient name/ID line under it)
         had its lower line cut off. Height is now "only as much as the text
         needs", with 48dp as the MINIMUM . short titled screens stay exactly
         as small as they are now, and only a long title grows, by about
         8dp. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/bg_login_hero"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/white"
        app:title="Medicine or Saline">

        <!-- 🔒 TK-APPROVED (29.07.2026, খাতার সারি B84): ব্রাঞ্চ বাছার ঘর
             হেডারের ডান দিকে, Follow-up · Draft · CHECK-UP Queue-র হুবহু একই
             পিল। ⛔ **একই id (`btnBranchChip`) রাখা হয়েছে**, তাই চাপ দিলে ঠিক
             আগের কাজটাই হয় — কোডের কোনো নিয়ম বদলায়নি, শুধু জায়গা ও চেহারা।
             পুরনো নকশা (2026-07-20-এর নিচের চিপ) এখানেই বদলে গেছে, TK-এর
             ফটো-প্রুফ পাশ করার পরে। -->
        <TextView
            android:id="@+id/btnBranchChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_branch_pill"
            android:text="🏥 Branch ▾"
            android:textColor="@color/white"
            android:textSize="10.5sp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <!-- Medicine Sale card -->
            <androidx.cardview.widget.CardView style="@style/RegCard">
                <LinearLayout style="@style/RegCardInner">
                    <TextView style="@style/SectionHead" android:layout_marginTop="0dp" android:layout_marginStart="-16dp" android:layout_marginEnd="-16dp" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:background="@drawable/bg_payment_header" android:textColor="@color/white" android:text="💊 Medicine or Saline" />

                    <!-- 🆕🔒 V805 (২৮.০৮.২০২৬, TK-অনুমোদিত ডেমো ফটো) — TK-নির্দেশ:
                         *"কোন রোগীকে স্যালাইন লাগানো হলে তার জন্য আলাদা টাকা নেয়া হয় …
                         এবার আমি চাইছি এখানে সেটা জয়েন করে দিন, অর্থাৎ নাম হবে
                         medicine or saline"*। নিচের দুটো বোতাম **Mode-এর (CASH/ONLINE)
                         হুবহু একই চেহারা ও একই কায়দায়** বসানো — নতুন কোনো ডিজাইন নয়। -->
                    <TextView style="@style/FieldLabel" android:text="Type" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                        <Button android:id="@+id/btnTypeMedicine" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:textAllCaps="false" android:text="💊 MEDICINE" />
                        <Button android:id="@+id/btnTypeSaline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAllCaps="false" android:text="💧 SALINE" />
                    </LinearLayout>

                    <TextView style="@style/FieldLabel" android:text="Patient Mobile / Name" />
                    <EditText android:id="@+id/etCustomer" style="@style/FieldInput" android:hint="Patient name or mobile" />
                    <LinearLayout
                        android:id="@+id/customerSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />

                    <TextView style="@style/FieldLabel" android:id="@+id/lblProduct" android:text="Medicine / Product Name" />
                    <!-- 🔒 B556 (08.08.2026, TK-অনুমোদিত প্রুফ) — একাধিক মেডিসিন:
                         প্রথম ঘর etProduct (id অপরিবর্তিত, তাই পুরনো কোড অটুট),
                         নিচে "+ ADD MEDICINE" চাপলে নতুন ঘর যোগ হয়। সেভের সময়
                         সব নাম কমা দিয়ে জুড়ে একটাই product-এ যায় (ডেটা-মডেল অটুট)। -->
                    <LinearLayout
                        android:id="@+id/medicineContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <EditText android:id="@+id/etProduct" style="@style/FieldInput" android:hint="Medicine / product name" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/btnAddMedicine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:background="@drawable/bg_price_chip"
                        android:text="＋ ADD MEDICINE"
                        android:textColor="#0B7A34"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <LinearLayout style="@style/Row2" android:layout_marginTop="0dp">
                        <LinearLayout style="@style/Col">
                            <TextView style="@style/FieldLabel" android:id="@+id/lblBill" android:text="Total Medicine Bill" />
                            <EditText android:id="@+id/etBill" style="@style/FieldInput" android:inputType="number" android:hint="Total bill" />
                        </LinearLayout>
                        <LinearLayout style="@style/ColEnd">
                            <TextView style="@style/FieldLabel" android:text="Deposit" />
                            <EditText android:id="@+id/etDeposit" style="@style/FieldInput" android:inputType="number" android:hint="Deposit" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/FieldLabel" android:text="Mode" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                        <Button android:id="@+id/btnMpCash" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:textAllCaps="false" android:text="💵 CASH" />
                        <Button android:id="@+id/btnMpUpi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAllCaps="false" android:text="💳 ONLINE" />
                    </LinearLayout>

                    <TextView style="@style/FieldLabel" android:text="Remarks" />
                    <EditText android:id="@+id/etRemarks" style="@style/FieldInput" android:hint="Remarks" android:minLines="2" android:gravity="top" />

                    <!-- 🔒 B556 (08.08.2026, TK-অনুমোদিত প্রুফ) — ৩টি সবুজ বোতাম
                         পাশাপাশি: Save · Share · Print। Save id অপরিবর্তিত (পুরনো
                         সেভ-লজিক অটুট)। Share/Print চাপলে আগে অটো-সেভ, তারপর
                         WhatsApp/প্রিন্ট — একবার সেভ হলে আর দ্বিতীয়বার সেভ হয় না। -->
                    <!-- 📏🔒 V805 (২৮.০৮.২০২৬) — TK: *"নিচে যে তিনটে বটম আছে Save
                         share print তিনটে একই সাইজের বোতাম হতে হবে, উচ্চতা যতটা কম
                         রেখে পারা যায়"*।
                         ─── কারণ (মেপে দেখা) ────────────────────────────────────
                         তিনটের চওড়া আগে থেকেই সমান ছিল (`weight=1`)। কিন্তু
                         **"🟢 Share" লেখাটা এক লাইনে ধরত না**, দু'লাইনে ভেঙে যেত —
                         `layout_height="wrap_content"` বলে ওই বোতামটাই লম্বা হয়ে
                         যেত। তাই তিনটে অসমান দেখাত।
                         ─── সারানো ──────────────────────────────────────────────
                         · উচ্চতা তিনটেরই বাঁধা **40dp** (আগের wrap_content-এর চেয়ে কম)
                         · `maxLines="1"` — লেখা আর কখনো দু'লাইনে ভাঙবে না
                         · ছোট আইকন + ছোট লেখা, যাতে এক লাইনেই ধরে -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:paddingStart="2dp" android:paddingEnd="2dp" android:layout_marginEnd="5dp" app:backgroundTint="#12A04A" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:text="💾 Save" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnShare" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:paddingStart="2dp" android:paddingEnd="2dp" android:layout_marginEnd="5dp" app:backgroundTint="#12A04A" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:text="🔗 Share" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPrint" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:minHeight="0dp" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:paddingStart="2dp" android:paddingEnd="2dp" app:backgroundTint="#12A04A" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false" android:text="🖨 Print" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- History card -->
            <androidx.cardview.widget.CardView style="@style/RegCard">
                <LinearLayout style="@style/RegCardInner">
                    <TextView style="@style/SectionHead" android:layout_marginTop="0dp" android:text="Medicine / Saline History" />

                    <!-- 🔒 B557 (08.08.2026, TK-অনুমোদিত প্রুফ) — প্রফেশনাল History:
                         সার্চ + Today/Last 7/Last 30/Pick Date চিপ + মোট বিক্রি।
                         সব ছাঁকা আগে-নামানো ডেটার উপরেই (client-side) — বাড়তি
                         সার্ভার-কল/egress নেই। -->
                    <EditText android:id="@+id/etHistorySearch" style="@style/FieldInput" android:hint="Search name / product / mobile" android:layout_marginTop="6dp" android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                        <TextView android:id="@+id/chipToday" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:gravity="center" android:paddingVertical="7dp" android:text="Today" android:textSize="10.5sp" android:textStyle="bold" android:textColor="#0B7A34" android:background="@drawable/bg_price_chip" />
                        <TextView android:id="@+id/chip7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:gravity="center" android:paddingVertical="7dp" android:text="Last 7 Days" android:textSize="10.5sp" android:textStyle="bold" android:textColor="#0B7A34" android:background="@drawable/bg_price_chip" />
                        <TextView android:id="@+id/chip30" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:gravity="center" android:paddingVertical="7dp" android:text="Last 30 Days" android:textSize="10.5sp" android:textStyle="bold" android:textColor="#0B7A34" android:background="@drawable/bg_price_chip" />
                        <TextView android:id="@+id/chipPick" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="7dp" android:text="Pick Date" android:textSize="10.5sp" android:textStyle="bold" android:textColor="#0B7A34" android:background="@drawable/bg_price_chip" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvHistoryTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="11dp"
                        android:background="@drawable/bg_payment_header"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:text="" />

                    <ProgressBar
                        android:id="@+id/progressLoad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No medicine payment yet."
                        android:textColor="@color/clinic_text_secondary"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/historyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/bottom_nav_bar" />
</LinearLayout>
