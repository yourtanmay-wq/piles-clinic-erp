<?xml version="1.0" encoding="utf-8"?>
<!-- TK-REQUESTED (2026-07-20): the Master branch chip on Chamber Attendance
     was showing "Jalpai.." (the default spinner text was too big for this
     narrow chip). This compact item makes the full branch name fit. Only
     the selected-chip text size changes; the branch picker/behaviour is
     completely unchanged. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textAllCaps="true"
    android:paddingHorizontal="2dp"
    android:paddingVertical="6dp"
    android:singleLine="true"
    android:ellipsize="end"
    android:textStyle="bold"
    android:textSize="11sp"
    android:textColor="#3B2A78" />
