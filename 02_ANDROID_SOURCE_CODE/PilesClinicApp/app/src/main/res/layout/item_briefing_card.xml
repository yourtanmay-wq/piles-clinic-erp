<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     DESIGN #4 "Priority accent" — TK approved (2026-08-06).
     Left colour bar (green = normal notice, red = action-required
     request), sender avatar + line, priority chip, clean flat
     action buttons (no emoji). ⛔ Every id the BriefingAdapter
     binds is kept EXACTLY (tvTitle, tvDate, tvMessage, tvTargets,
     tvReplies, btnApproveDelete, btnSeen, btnReply, btnDelete);
     new ids added: priorityBar, tvAvatar, tvWho, tvChip.
     Buttons are styled TextViews (not <Button>) so the flat
     backgrounds render reliably — Material <Button> was tinting
     them navy and ignoring the intended colour before.
     ============================================================ -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="13dp"
    app:cardElevation="1.5dp"
    app:cardBackgroundColor="@color/clinic_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left priority bar: colour set in adapter (green/red) -->
        <View
            android:id="@+id/priorityBar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#16A34A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- Top row: avatar · sender+time · priority chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_brief_avatar"
                    android:gravity="center"
                    android:text="N"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="All Staff"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#14361F" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="date"
                        android:textSize="10sp"
                        android:textColor="@color/clinic_text_secondary" />
                </LinearLayout>

                <!-- 🆕 TK-নির্দেশ (07.08.2026): "অনুমতি অনেকগুলো একসাথে হয়ে গেলে
                     মার্ক করে একবারে অনুমোদন দেওয়া যাবে" — শুধু Master-এর
                     অনুমোদন-নোটিশে দেখা যায় (adapter ঠিক করে), বাকি সব কার্ডে gone। -->
                <CheckBox
                    android:id="@+id/cbSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brief_chip_normal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="NOTICE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#166534" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Title"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Message"
                android:textSize="11.5sp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#374151" />

            <TextView
                android:id="@+id/tvTargets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="All Staff"
                android:textSize="10sp"
                android:textColor="@color/brand_blue" />

            <TextView
                android:id="@+id/tvReplies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_remark_box"
                android:padding="7dp"
                android:text="No replies yet"
                android:textSize="10.5sp"
                android:textColor="#3A4A63" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <!-- 🔴 TK-অনুমোদিত প্রুফ (07.08.2026): অনুমোদন-বোতামটা আগে নিজের
                     আলাদা লাইনে পুরো চওড়ায় ছিল; এখন Reply/Delete-এর সাথে **এক
                     লাইনে** (তিনটে পাশাপাশি) — কার্ড আরও কম উঁচু হয়।
                     ⛔ `id` এক অক্ষরও বদলায়নি (BriefingAdapter-এর
                     `b.btnApproveDelete` আগের মতোই কাজ করে), দেখা/লুকানোর
                     নিয়মও অপরিবর্তিত — শুধু জায়গা ও চওড়া বদলেছে।
                     লুকানো থাকলে (সাধারণ নোটিশ) বাকি দুটো বোতাম নিজেরাই
                     জায়গা নিয়ে নেয়, তাই কোনো ফাঁক থাকে না। -->
                <TextView
                    android:id="@+id/btnApproveDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_brief_btn_dark"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingVertical="8dp"
                    android:text="Approve"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

                <!-- 🔴 TK-নির্দেশ (07.08.2026): "সিন করছি মানেই সিন — নোটিফিকেশন
                     খুললেই তো অটোমেটিক সিন হয়ে যাচ্ছে, আবার কেন চাপব"। তাই এই
                     বোতামটা লুকানো হলো (Briefing খুললেই সব নোটিশ নিজে থেকে সিন
                     হয় — BriefingActivity.autoSeenOnOpen)। ⛔ id/অ্যাডাপ্টারের
                     বাইন্ডিং অক্ষত রাখা হয়েছে, শুধু visibility=gone — তাই কোনো
                     পুরনো কোড ভাঙেনি, দরকার হলে এক লাইনে ফেরানো যাবে। -->
                <TextView
                    android:id="@+id/btnSeen"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_brief_btn_dark"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="Seen"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <!-- 🔴🔒 V501 (TK-নির্দেশ ২১.০৮.২০২৬, ফটো-প্রুফ অনুমোদিত):
                     *"এই ধরনের নোটিফিকেশনে ভিউ অপশন থাকতে হবে; ভিউতে ক্লিক
                     করলে অটো রিডাইরেক্ট হবে।"*
                     ⛔ শুরুতে `gone` — শুধু যে নোটিশে রোগীর মোবাইল নম্বর আছে
                        (New Enquiry / Registration / Visit / Advance) সেখানেই
                        দেখা যায়, নইলে অকেজো বোতাম দেখাত।
                     ⛔ Reply/Delete-এর মাপ, রং, কাজ কিছুই বদলায়নি। -->
                <TextView
                    android:id="@+id/btnViewRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_brief_btn_ghost"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="View"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#0A7A45"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnReply"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_brief_btn_ghost"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="Reply"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/btnDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brief_btn_danger"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Delete"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#E11D48" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
