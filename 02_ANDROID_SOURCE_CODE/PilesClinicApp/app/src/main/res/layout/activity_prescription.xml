<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient">

    <!-- TK-REPORTED BUG FIX (2026-07-25): this header was locked to a
         fixed 48dp when the headers were made smaller, so any title that
         needs two lines (or a title plus the patient name/ID line under it)
         had its lower line cut off. Height is now "only as much as the text
         needs", with 48dp as the MINIMUM . short titled screens stay exactly
         as small as they are now, and only a long title grows, by about
         8dp. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/bg_login_hero"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/white"
        app:title="Prescription" />

    <TextView
        android:id="@+id/tvReadOnlyNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@color/clinic_accent_amber"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="View only — Staff cannot edit the prescription." />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="center"
        android:textColor="@color/clinic_text_secondary"
        android:visibility="gone"
        android:text="No medicine added yet" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMedicines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/clinic_card">

        <!-- 🔴 TK-নির্দেশ (২৭.০৮.২০২৬, ছবিসহ): *"এই ২ টা পাশাপাশি থাকতে হবে"* —
             দুটো Add বোতাম এখন এক সারিতে, নিচের Save / Save & Print-এর হুবহু
             একই ধাঁচে (weight=1 করে সমান ভাগ, মাঝে ১২dp ফাঁক)।
             ⛔ বোতামের আইডি · লেখা · কাজ — কিচ্ছু বদলায়নি, শুধু সাজ।
             ⛔ TK-DECISION (2026-07-22) অক্ষত: পুরনো "⭐ Apply Common
                Prescription" বোতামটা এখানে নেই, ওটা Reference-List বাছার
                পর্দায় "⭐ Common" চিপ হয়ে আছে। -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFromReference"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="+ Add from Reference List" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBlank"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="+ Add Medicine (Outside List)" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePrescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_navy" app:backgroundTint="@null"
                android:textColor="@color/white"
                android:text="Save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAndPrint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/clinic_accent_green"
                android:text="Save &amp; Print" />

        </LinearLayout>

        <!-- 🔴 TK-নির্দেশ (২৭.০৮.২০২৬, ছবিসহ): *"share As Text থাকবে না"* —
             Prescription পর্দা থেকে বোতামটা বাদ। Save ও Save & Print আগের
             মতোই আছে, ওখান থেকেই শেয়ার/ছাপা হয়।
             ⛔ Medicine Slip · Diet Chart-এর নিজেদের Share বোতাম ছোঁয়া হয়নি —
                TK শুধু এই পর্দার কথা বলেছেন। -->
    </LinearLayout>
</LinearLayout>
