<?xml version="1.0" encoding="utf-8"?>
<!-- 🔴🔒 V1510 (TK-রিপোর্ট ১৬.০৯.২০২৬ — "Change Password লেখাটা এত বড় রাখার
     দরকার নেই, যতটা কমপ্যাক্ট করা যায়") — আগে Password ও Change Password
     বোতাম দুটো আলাদা সারিতে, দুটোই পুরো চওড়া জুড়ে ছিল, তাই কার্ডটা লম্বা
     হতো। এখন দুটো পাশাপাশি এক সারিতে (Password বাঁয়ে বেশি জায়গা নিয়ে,
     বোতামটা শুধু নিজের মাপে) — margin/padding/টেক্সট-সাইজও ছোট করা হলো।
     ⛔ কোনো তথ্য/কাজ বাদ পড়েনি, শুধু জায়গা কম নেয়। -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/clinic_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 🔴🔒 V1510 — এখন এই ঘরে "স্টাফের আসল নাম (কোড)" বসে, আগে শুধু
             কোড বসত (PasswordCenterActivity.kt-এ তৈরি, hr.staff_profiles
             থেকে নাম মিলিয়ে)। TK-রিপোর্ট: লম্বা নাম যেন কাটা না পড়ে,
             তাই ফন্ট 14sp থেকে 12sp করা হলো। -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/clinic_text_primary" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="role · branch · mobile"
            android:textSize="10.5sp"
            android:textColor="@color/clinic_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_remark_box"
                android:padding="6dp"
                android:text="Password: ••••"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/clinic_text_primary" />

            <Button
                android:id="@+id/btnChange"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_action_view"
                android:text="🔑 Change"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
