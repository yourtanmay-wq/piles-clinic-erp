<?xml version="1.0" encoding="utf-8"?>
<!--
  Follow-up card (v4, TK-approved proof):
    TOP ROW  = [LEFT column] + [MAIN column]
       LEFT  : Enquiry -> call-signal + "Enquiry" + Enquiry-date
               Visit   -> avatar + VISITED pill + full Patient ID (1 line)
               Patient -> avatar + full Patient ID (no pill)
       MAIN  : name / mobile / BRANCH|DISEASE, with badge (Enquiry) /
               Visit-Advance (Visit) / Prescription+ring+Bill-Due (Patient)
               pinned top-right; then Next Follow-up + Last Remark.
    BOTTOM ROW = 4 action buttons FULL WIDTH (edge to edge under the photo too).
  Middle text is nudged slightly right (main marginStart) so it sits between
  the photo and the right slot. Patient ID never breaks (single line).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 🟢🔒 V694 (২৬.০৮.২০২৬, TK-নির্দেশ ছবিসহ — "followup Card এ যেমন চেহারা
         ঠিক তেমন করে দিন") — V648-এর লাল সিরিয়াল ব্যাজটা এখানে FrameLayout-এর
         **প্রথম** সন্তান হিসেবে ভাসিয়ে রাখা ছিল, আর তার পরেই আসত কার্ডের
         নিরেট সাদা ব্যাকগ্রাউন্ড — তাই ব্যাজটা **কার্ডের নিচে চাপা পড়ে যেত,
         পর্দায় কোনোদিন দেখাই যায়নি**। এখন সেটা নামের ঠিক বাঁ পাশে বসানো
         হলো (নিচে `llNameRow`), হুবহু আসল Follow-up কার্ডের মতো। -->

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:padding="9dp"
    android:background="@drawable/bg_follow_card">

    <!-- TOP ROW: LEFT + MAIN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ========== LEFT column (photo / signal + ID) ========== -->
        <LinearLayout
            android:id="@+id/llLeft"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Enquiry: call-signal meter -->
            <LinearLayout
                android:id="@+id/llCallSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- 🎨🔒 V882 (৩০.০৮.২০২৬, TK-নির্দেশ, ডেমো-প্রুফে অনুমোদিত):
                     TK: *"Wi-Fi signal তার নিচে তারিখটা কেটে গেল কেন — ওয়াইফাই
                     সিগনাল সামান্য একটু উপরে তুলুন বা সাইজে ছোট করুন"*।
                     বাঁ দিকের কলামটা ডান দিকের চেয়ে লম্বা হয়ে যেত, তাই নিচের
                     তারিখটা কেটে যেত। সিগন্যালের উচ্চতা ৪০dp → ৩৪dp আর নিচের
                     ফাঁক ৭dp → ৩dp — মোট ১০dp জায়গা খালি হলো, তারিখ পুরো বসে।
                     ⛔ কার্ডের আর কিছুই বদলায়নি — লেখা · রং · মাপ সব একই। -->
                <ImageView
                    android:id="@+id/ivWifiSignal"
                    android:layout_width="48dp"
                    android:layout_height="34dp"
                    android:contentDescription="Enquiry calls: 0 of 5"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wifi_calls_0" />

                <TextView
                    android:id="@+id/tvSignalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Enquiry"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#1067D8" />

                <TextView
                    android:id="@+id/tvSignalDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text=""
                    android:textSize="8sp"
                    android:textColor="#667085" />

                <!-- TK-REQUESTED ADDITION (2026-07-23): small Official/Unexpected
                     Time badge on the Enquiry card. Default gone; the adapter
                     shows it only for Enquiry rows that carry a timeType. -->
                <TextView
                    android:id="@+id/tvTimeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:text=""
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Visit / Patient: avatar + VISITED pill + full Patient ID -->
            <LinearLayout
                android:id="@+id/llPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <!-- 🟢🔒🔒 V649 (২৫.০৮.২০২৬, TK-নির্দেশ, ছবিসহ — "Follow-up
                     সেকশনের মতনই চেহারা হতে হবে") — আসল Follow-up কার্ডে
                     কোনো ছবি/অ্যাভাটার-বাক্সই নেই (TK-এর নিজের ছবিতে
                     নিশ্চিত)। ছবি ইচ্ছাকৃতভাবে আনা হয় না (ফ্রি-প্ল্যানে
                     এগ্রেস বাঁচাতে, TK-অনুমোদিত), তাই একটা ফাঁকা ধূসর
                     "মানুষ-আইকন" বাক্স দেখানো বিভ্রান্তিকর ও আসল কার্ডের
                     সাথে না-মেলা — তাই পুরোপুরি সরানো হলো। -->
                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVisitedPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_visited_pill"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="2dp"
                    android:text="VISITED"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <!-- Full Original Patient ID — single line, never breaks -->
                <TextView
                    android:id="@+id/tvRegDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:textColor="#10223A" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== MAIN column (nudged slightly right) ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- 🟢🔒 V694 — আসল কার্ডের `nameRow`-এর হুবহু নকল:
                         লাল সিরিয়াল ব্যাজ, ৯dp ফাঁক, তারপর নাম+মোবাইলের
                         নিজের কলাম (দুটোরই বাঁ প্রান্ত এক জায়গায়)।
                         মাপও আসল কার্ডের মতো — নাম 16sp, মোবাইল 12.5sp। -->
                    <LinearLayout
                        android:id="@+id/llNameRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvFuSerial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="9dp"
                            android:minWidth="24dp"
                            android:gravity="center"
                            android:background="@drawable/bg_serial_red"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:text="1"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Patient Name"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="#10223A" />

                            <TextView
                                android:id="@+id/tvMobile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="📞 9999999999"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="12.5sp"
                                android:textColor="#5B6B81" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvBranch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_branch"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:maxWidth="120dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="BRANCH"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="5dp"
                            android:text="|"
                            android:textSize="12sp"
                            android:textColor="#98A2B3" />

                        <TextView
                            android:id="@+id/tvDisease"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_disease"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:maxWidth="120dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="DISEASE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <!-- 🟢🔒 V694 — Visit/Patient কার্ডে VISITED/PATIENT পিল ও
                         রোগীর আইডি এখন এখানে, ট্যাগের ঠিক নিচে নিজের সারিতে —
                         হুবহু আসল Follow-up কার্ডের `idRow`-এর মতো। আগে এগুলো
                         বাঁদিকের ৬২dp কলামে বসত, তাই নাম-মোবাইল ডানে সরে গিয়ে
                         পর্দাটা আসল কার্ডের চেয়ে আলাদা দেখাত। Enquiry-তে এই
                         সারি থাকে না (আসল কার্ডেও নেই)। -->
                    <LinearLayout
                        android:id="@+id/llIdRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_visited_pill"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="PATIENT"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvIdOnRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:maxLines="1"
                            android:text="FLK-00000000-000"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#10223A" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right slot: badge / Visit-Advance / Prescription+ring -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal|top">

                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_badge"
                        android:text="Today Due"
                        android:textColor="@color/white"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVisitAdvance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:background="@drawable/bg_visit_advance"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:text="👣 Visit\nAdvance"
                        android:textStyle="bold"
                        android:textSize="9.5sp"
                        android:lineSpacingMultiplier="1.0"
                        android:textColor="#0B4F2A"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/llPayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:visibility="gone">

                        <!-- 🔴🔒 V683 (২৫.০৮.২০২৬, TK-লাইভ-টেস্ট রিপোর্ট, ছবি
                             মিলিয়ে যাচাই — "ফলোআপ কার্ডের থেকে এগুলো কেন
                             আলাদা") — আসল কারণ: এই আলাদা FollowUpAdapter-এর
                             XML সবসময় FollowUpActivity.buildFollowCard()-এর
                             থেকে আলাদা টেমপ্লেট ছিল (V648/V649-এ আংশিক
                             মেলানো হয়েছিল, ring/Bill-Due-pill/uppercase বাদ
                             থেকে গিয়েছিল)। এখন হুবহু আসল কার্ডের মতোই:
                             PRESCRIPTION বড় হাতের অক্ষরে + bg_chip_blue। -->
                        <TextView
                            android:id="@+id/tvPrescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_blue"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="PRESCRIPTION"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="#1067D8" />

                        <!-- V683 — সলিড চাকতির বদলে আসল কার্ডের PaymentRingView
                             (প্রমাণিত, ঝুঁকিহীন — শুধু এখানেও বসানো হলো)। -->
                        <com.tkbiswas.pilesclinic.ui.PaymentRingView
                            android:id="@+id/paymentRing"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp" />

                        <!-- V683 — আসল কার্ডের মতো আলাদা রঙিন Bill/Due পিল
                             (আগে একটাই প্লেইন "0 / 0" লেখা ছিল)। -->
                        <LinearLayout
                            android:id="@+id/llBillDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvBillPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:paddingVertical="3dp"
                                android:text="Bill\n₹0"
                                android:textSize="8.3sp"
                                android:textStyle="bold"
                                android:textColor="#0B8F3C"
                                android:background="@drawable/bg_pill_bill_green" />

                            <TextView
                                android:id="@+id/tvDuePill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:paddingVertical="3dp"
                                android:text="Due\n₹0"
                                android:textSize="8.3sp"
                                android:textStyle="bold"
                                android:textColor="#D92D20"
                                android:background="@drawable/bg_pill_due_red" />
                        </LinearLayout>

                        <!-- V683 — পুরনো tvBillDue আর দেখানো হয় না (উপরের দুই
                             পিল দিয়ে বদলানো হলো), কিন্তু id মোছা হয়নি — কোনো
                             পুরনো কোড এই id খুঁজলে যেন ক্র্যাশ না করে। -->
                        <TextView
                            android:id="@+id/tvBillDue"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 🟢🔒🔒 V649 (২৫.০৮.২০২৬, TK-নির্দেশ — "আরো ভালোভাবে যাচাই
                 করুন গভীরে গিয়ে") — আসল Follow-up কার্ডে "LAST CALL...
                 NEXT CALL..." লাইনটা রিমার্ক-বাক্সের **ভেতরে**, উপরে থাকে —
                 এই আলাদা FollowUpAdapter-এ এই লাইনটা কখনো ছিলই না (শুধু
                 নিচের ফাঁকা "Next Follow-up" লাইন ছিল, ভুল জায়গায়/ভুল
                 লেখায়)। এখন সেই ঘরটাই বাদ, নিচের রিমার্ক-বাক্সের ভেতরেই
                 সঠিক জায়গায় বসানো হলো। -->

        </LinearLayout>
    </LinearLayout>

    <!-- TK-APPROVED (2026-07-25, proof made on TK's own screenshot): the
         Remark box was inside the right hand column, so it started well
         away from the card's left edge. It now sits directly in the card,
         between the details row above and the 4 buttons below, so it runs
         the full width exactly like the button row (this is how the RMP /
         Dr. Visit card already looks). Same id, same colours, same text,
         same triple.tap edit . only its width/position changed. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_remark_dashed"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLastCall"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="LAST CALL —"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#344054" />

            <TextView
                android:id="@+id/tvNextFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT CALL —"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#344054" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:background="#D8E4F2" />

        <TextView
            android:id="@+id/tvRemark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="11.5sp"
            android:textColor="#10223A" />
    </LinearLayout>

    <!-- BOTTOM ROW: 4 buttons, FULL WIDTH -->
    <!-- 🟢🔒🔒 V648 (২৫.০৮.২০২৬, TK-রিপোর্ট, ছবিসহ — "Navy blue কালার হবে না")
         — **আসল কারণ (কোড ধরে যাচাই):** এই চারটে `<Button>` উইজেট (নিচে,
         আগে) অ্যাপের থিমের `colorPrimary` (#0F2748 — গাঢ় নেভি নীল) দিয়ে
         স্বয়ংক্রিয়ভাবে রং হয়ে যাচ্ছিল (Material থিমের ডিফল্ট বোতাম-স্টাইল
         `android:background`-এর নিজের সবুজ/নীল/বেগুনি রং ঢেকে দিচ্ছিল) —
         `item_draft_card.xml`-এর প্রমাণিতভাবে-কাজ-করা একই বোতাম-সারি
         `<TextView>` ব্যবহার করে (Button না), যেটা এই থিম-ওভাররাইডের
         শিকার হয় না। এখানেও ঠিক সেই একই, প্রমাণিত প্যাটার্নে বদলানো হলো —
         রং/আইকন/আকার এক অক্ষরও বদলায়নি, শুধু widget-এর ধরন। ⛔ ক্লিক-লজিক
         (FollowUpAdapter.kt-এর setOnClickListener) TextView-তেও হুবহু
         একইভাবে কাজ করে, কিছু ভাঙে না। -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:background="@drawable/bg_action_call"
            android:text="📞"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btnWhatsApp"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:background="@drawable/bg_action_whatsapp"
            android:text="💬"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btnRemark"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:background="@drawable/bg_action_view"
            android:text="👁"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

        <!-- V683 — আসল কার্ডে তীর-বোতাম বেগুনি না, নীল (bg_action_view, eye
             বোতামের মতোই একই রং)। -->
        <TextView
            android:id="@+id/btnNextFollow"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_action_view"
            android:text="➜"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
