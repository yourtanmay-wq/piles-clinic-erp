<?xml version="1.0" encoding="utf-8"?>
<!--
  Follow-up card (v4, TK-approved proof):
    TOP ROW  = [LEFT column] + [MAIN column]
       LEFT  : Enquiry -> call-signal + "Enquiry" + Enquiry-date
               Visit   -> avatar + VISITED pill + full Patient ID (1 line)
               Patient -> avatar + full Patient ID (no pill)
       MAIN  : name / mobile / BRANCH|DISEASE, with badge (Enquiry) /
               Visit-Advance (Visit) / Prescription+ring+Bill-Due (Patient)
               pinned top-right; then Next Follow-up + Last Remark.
    BOTTOM ROW = 4 action buttons FULL WIDTH (edge to edge under the photo too).
  Middle text is nudged slightly right (main marginStart) so it sits between
  the photo and the right slot. Patient ID never breaks (single line).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:padding="9dp"
    android:background="@drawable/bg_follow_card">

    <!-- TOP ROW: LEFT + MAIN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ========== LEFT column (photo / signal + ID) ========== -->
        <LinearLayout
            android:id="@+id/llLeft"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Enquiry: call-signal meter -->
            <LinearLayout
                android:id="@+id/llCallSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivWifiSignal"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:contentDescription="Enquiry calls: 0 of 5"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wifi_calls_0" />

                <TextView
                    android:id="@+id/tvSignalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Enquiry"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="#1067D8" />

                <TextView
                    android:id="@+id/tvSignalDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:text=""
                    android:textSize="8sp"
                    android:textColor="#667085" />

                <!-- TK-REQUESTED ADDITION (2026-07-23): small Official/Unexpected
                     Time badge on the Enquiry card. Default gone; the adapter
                     shows it only for Enquiry rows that carry a timeType. -->
                <TextView
                    android:id="@+id/tvTimeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:text=""
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Visit / Patient: avatar + VISITED pill + full Patient ID -->
            <LinearLayout
                android:id="@+id/llPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_avatar_square"
                    android:text="👤"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tvVisitedPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_visited_pill"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="2dp"
                    android:text="VISITED"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <!-- Full Original Patient ID — single line, never breaks -->
                <TextView
                    android:id="@+id/tvRegDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:textColor="#10223A" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== MAIN column (nudged slightly right) ========== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👤 Patient Name"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#10223A" />

                    <TextView
                        android:id="@+id/tvMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="📞 9999999999"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textColor="#5B6B81" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvBranch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_branch"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:maxWidth="120dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="BRANCH"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="5dp"
                            android:text="|"
                            android:textSize="12sp"
                            android:textColor="#98A2B3" />

                        <TextView
                            android:id="@+id/tvDisease"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_disease"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="3dp"
                            android:maxWidth="120dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="DISEASE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right slot: badge / Visit-Advance / Prescription+ring -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal|top">

                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_badge"
                        android:text="Today Due"
                        android:textColor="@color/white"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVisitAdvance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:background="@drawable/bg_visit_advance"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:text="👣 Visit\nAdvance"
                        android:textStyle="bold"
                        android:textSize="9.5sp"
                        android:lineSpacingMultiplier="1.0"
                        android:textColor="#0B4F2A"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/llPayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPrescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_blue"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Prescription"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#1067D8" />

                        <TextView
                            android:id="@+id/tvPayPct"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:background="@drawable/bg_circle_gradient"
                            android:text="0%"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvBillDue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:text="0 / 0"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:textColor="#475467" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNextFollow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                android:textSize="12sp"
                android:textColor="#344054" />

        </LinearLayout>
    </LinearLayout>

    <!-- TK-APPROVED (2026-07-25, proof made on TK's own screenshot): the
         Remark box was inside the right hand column, so it started well
         away from the card's left edge. It now sits directly in the card,
         between the details row above and the 4 buttons below, so it runs
         the full width exactly like the button row (this is how the RMP /
         Dr. Visit card already looks). Same id, same colours, same text,
         same triple.tap edit . only its width/position changed. -->
    <TextView
        android:id="@+id/tvRemark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_remark_dashed"
        android:padding="7dp"
        android:text="—"
        android:textSize="11.5sp"
        android:textColor="#10223A" />

    <!-- BOTTOM ROW: 4 buttons, FULL WIDTH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_action_call"
            android:text="📞"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btnWhatsApp"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_action_whatsapp"
            android:text="💬"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btnRemark"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_action_view"
            android:text="👁"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btnNextFollow"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_next"
            android:text="➜"
            android:textSize="14sp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
</LinearLayout>
