<?xml version="1.0" encoding="utf-8"?>
<!-- TK-REQUESTED REDESIGN (2026-07-16): register-style table row (Visit# /
     Date / Progress / Paid / Due), replacing the old spacious card, matching
     TK's paper "Patient Progress Report" register. Approved after 3 proof
     rounds (professional look, dd/MM/yyyy dates, ₹ symbol). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="9dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvVisitNo"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:textColor="#10223A"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="—"
        android:textSize="8.5sp"
        android:textColor="#6E7A8C" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update"
            android:textStyle="bold"
            android:textSize="9.5sp"
            android:textColor="#10223A" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textSize="8.3sp"
            android:textColor="#5B6B81"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPaid"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="—"
        android:textSize="8.8sp"
        android:textStyle="bold"
        android:textColor="#0EA25F"
        android:gravity="end" />

    <TextView
        android:id="@+id/tvDue"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="—"
        android:textSize="8.8sp"
        android:textStyle="bold"
        android:textColor="#B42318"
        android:gravity="end" />
</LinearLayout>
