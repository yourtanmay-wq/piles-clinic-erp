<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient">

    <!-- TK-REPORTED BUG FIX (2026-07-25): this header was locked to a
         fixed 48dp when the headers were made smaller, so any title that
         needs two lines (or a title plus the patient name/ID line under it)
         had its lower line cut off. Height is now "only as much as the text
         needs", with 48dp as the MINIMUM . short titled screens stay exactly
         as small as they are now, and only a long title grows, by about
         8dp. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/bg_login_hero"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/white"
        app:title="Patient History — Clinical View" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:textColor="@color/clinic_text_secondary"
        android:visibility="gone"
        android:text="No clinical activity recorded yet for this patient. Complete a Check-up, Prescription, Investigation or Diet Chart and it will appear here." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp"
        android:clipToPadding="false" />
</LinearLayout>
