<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet: needed for Supabase cloud sync (app works offline via localStorage
         when unavailable, matching the existing web app's offline-first design) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 🔴🆕🔒 খাতার সারি B440 (05.08.2026, TK-নির্দেশ) — Work Notebook-এ
         "Outside Calls Today" ঘরের ডিফল্ট মান স্বয়ংক্রিয়ভাবে ফোনের
         Incoming Call থেকে গণনা করতে। ⛔ স্টাফ Allow না করলে/এই অনুমতি না
         থাকলে ঘরটা আগের মতোই সম্পূর্ণ হাতে-লেখা থেকে যায়, কিছুই আটকায় না। -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- 🔴🆕🔒 B441 (05.08.2026, TK-নির্দেশ) — দুই-SIM ফোনে কোন SIM
         ব্রাঞ্চের নম্বর তা আলাদা করতে (নইলে দুটো SIM-এর কল মিলিয়ে ভুল
         সংখ্যা দেখাত)। ⛔ না দিলে/না থাকলে সব SIM মিলিয়ে গোনে, আটকায় না। -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 👆🔒 V496 (২১.০৮.২০২৬, TK §৩): Staff-এর হাজিরা ও Doctor-এর অ্যাপ খোলার
         জন্য Android-এর নিরাপদ আঙুলের-ছাপ পর্দা। ⛔ কোনো আঙুলের ছাপ বা ছবি
         অ্যাপে/ক্লাউডে যায় না — Android শুধু সফল/ব্যর্থ জানায়। -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!-- 📍🔒 V496 (TK §৫): Staff-এর IN TIME-এ "ক্লিনিকে আছেন কিনা" দেখার জন্য।
         ⛔ GPS সারাক্ষণ চলে না — শুধু IN TIME চাপার মুহূর্তে, ফল পেলেই বন্ধ।
         ⛔ background location চাওয়া হয়নি; অবস্থান কোথাও সেভ/পাঠানো হয় না। -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- 🔴🔴🔴 TK-রিপোর্ট (05.08.2026) — IN/OUT TIME · Call Reminder ·
         Chamber Close Reminder তিনটেই ব্যাকগ্রাউন্ডে (WorkManager) চলে;
         অ্যাপ বন্ধ থাকলে কিছু ফোনের (Xiaomi/Vivo/Oppo-ঘরানার) নিজস্ব
         ব্যাটারি-সেভিং এই কাজ আটকে দেয়। এই অনুমতি (শুধু নিজের অ্যাপের
         জন্য, সিস্টেম পপ-আপে স্টাফ নিজে অনুমতি দেবেন) ছাড়া রিমাইন্ডার
         নির্ভরযোগ্যভাবে আসতেই পারে না। ⛔ অন্য কোনো অ্যাপ/সিস্টেম আচরণ
         এতে ছোঁয়া হয় না, শুধু এই একটা অ্যাপকে ব্যাটারি-সেভিং থেকে বাদ
         রাখতে বলা হয়। -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- TK-APPROVED (2026-07-28): Android 11 theke onno app "dekha jay na"
         jodi na ekhane lekha thake. Eta na thakle WhatsApp install thakleo
         chobi-soho pathano kaj korto na. Sudhu ei duto app o SMS app dekha
         jay; onno kono app-er tothyo neoya hoy na. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- V235 (TK, Call Chooser project-wide): Android 11+ e dialer app-gulo
             "dekha jay na" jodi ei tel: query na thake. Eta na thakle CallChooser-er
             queryIntentActivities(ACTION_DIAL) khali list dey, tai custom chooser
             kaj kore na o Vivo/Samsung-e phone sorasori default dialer khule jay.
             ACTION_DIAL o ACTION_VIEW duto tel scheme dhora holo jate sob installed
             dialer (Phone / Super Phone / etc.) chooser-e dekha jay. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!-- Camera: needed for patient photo capture (existing feature in the web app) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Storage: needed for selecting photos from gallery, and for backup/export -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Phase 6: Professional Print System -->
    <uses-feature android:name="android.software.print" android:required="false" />

    <application
