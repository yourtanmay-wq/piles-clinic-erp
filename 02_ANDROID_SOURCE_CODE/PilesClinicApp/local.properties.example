## Copy this file to "local.properties" (same folder) and fill in your real
## values. "local.properties" is git-ignored and must NEVER be committed or
## shared — it holds your Supabase project's secret-ish Anon Key.
##
## Where to find these in Supabase: Project Settings -> API
##   Project URL      -> SUPABASE_URL
##   anon / public key -> SUPABASE_ANON_KEY   (this is the public client key,
##                        safe to ship inside an app, but still keep it out of
##                        version control as good hygiene)

sdk.dir=/path/to/your/Android/sdk

SUPABASE_URL=https://bcyeogjqtupbdyciqfmz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_k_170-JGrdxmZ7rBrjCyTA_-ElK2XdZ

## Phase 9-10: release signing (only needed to produce a signed Release APK/AAB).
## Generate a keystore once with (from a terminal, keytool ships with the JDK):
##   keytool -genkeypair -v -keystore release-keystore.jks -alias pilesclinic \
##     -keyalg RSA -keysize 2048 -validity 10000
## Then fill in the real path/passwords below. NEVER commit this file or the
## .jks itself — both must stay out of version control.
RELEASE_KEYSTORE_PATH=/absolute/path/to/release-keystore.jks
RELEASE_KEYSTORE_PASSWORD=your-keystore-password
RELEASE_KEY_ALIAS=pilesclinic
RELEASE_KEY_PASSWORD=your-key-password
